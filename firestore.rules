rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the signed-in user has role == "admin" on their OWN user doc.
    // `role` is writable only server-side (see the users rules below), so a
    // client cannot forge it — this check is trustworthy and server-evaluated.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function ownsPdf() {
      return request.auth != null
        && resource.data.get('autor_id', '') == request.auth.uid;
    }

    function canReadPdf(pdfId) {
      return exists(/databases/$(database)/documents/pdfs/$(pdfId))
        && (isAdmin()
          || get(/databases/$(database)/documents/pdfs/$(pdfId)).data.get('is_public', true) == true
          || (request.auth != null
            && get(/databases/$(database)/documents/pdfs/$(pdfId)).data.get('autor_id', '') == request.auth.uid));
    }

    match /users/{id} {
      allow read, delete: if request.auth.uid != null && request.auth.uid == id;
      // Owners update their own profile, but NEVER their own `role`
      // (no self-promotion to admin). `role` is set only server-side
      // (Cloud Function / console), never from the client.
      allow update: if request.auth.uid != null && request.auth.uid == id
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow create: if request.auth.uid != null && request.auth.uid == id
                    && !request.resource.data.keys().hasAny(['role']);
    }
    match /users/{id}/{document=**} {
    	allow read, update, create, delete: if request.auth.uid != null && request.auth.uid == id;
    }
    // Explicit rule for notifications subcollection (count() queries need this)
    match /users/{id}/notifications/{notId} {
      allow read: if request.auth.uid != null && request.auth.uid == id;
      allow create, update, delete: if false;
    }
    match /subscriptions/{userId} {
      allow read: if request.auth.uid != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }
    match /feature_requests/{featureId} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null
                    && request.resource.data.active == false
                    && request.resource.data.votes == 0;
      // Either a normal ±1 vote by any signed-in user, OR full moderation
      // (toggle visibility, edit translations) by an admin.
      allow update: if request.auth.uid != null
                    && (
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'last_update_date'])
                        && (request.resource.data.votes == resource.data.votes + 1
                            || request.resource.data.votes == resource.data.votes - 1))
                      || isAdmin()
                    );
      allow delete: if false;
    }
    match /feature_requests/{featureId}/votes/{id} {
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
    // Collection group rules for votes
    match /{path=**}/votes/{voteId} {
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth.uid != null && request.auth.uid == resource.data.userId ;
      allow update, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }
    match /user_feature_requests/{id} {
      allow create: if request.auth.uid != null;
      allow read, update, delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }

    match /kanban_columns/{columnId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if isAdmin();
    }
    match /kanban_tasks/{taskId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── Library (Categorias, PDFs, Comentários e Favoritos) ───────────────────
    match /categories/{categoryId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if isAdmin();
    }
    match /autores/{autorId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if request.auth.uid != null;
    }
    match /pdfs/{pdfId} {
      allow read: if isAdmin() || resource.data.get('is_public', true) == true || ownsPdf();
      allow create: if request.auth != null
        && request.resource.data.autor_id == request.auth.uid
        && request.resource.data.is_public is bool
        && request.resource.data.storage_path == 'community_pdfs/' + request.auth.uid + '/' + pdfId;
      allow update: if isAdmin() || (ownsPdf()
        && request.resource.data.autor_id == resource.data.autor_id
        && request.resource.data.storage_path == resource.data.storage_path
        && request.resource.data.is_public is bool);
      allow delete: if isAdmin() || ownsPdf();
    }
    match /comments/{commentId} {
      allow read: if request.auth != null && canReadPdf(resource.data.get('pdf_id', ''));
      allow create: if request.auth != null
        && request.resource.data.usuario_id == request.auth.uid
        && canReadPdf(request.resource.data.get('pdf_id', ''));
      allow update, delete: if isAdmin() || (request.auth != null
        && resource.data.usuario_id == request.auth.uid
        && canReadPdf(resource.data.get('pdf_id', '')));
    }
    match /bookmarks/{bookmarkId} {
      allow read, delete: if request.auth != null
        && resource.data.usuario_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.usuario_id == request.auth.uid
        && canReadPdf(request.resource.data.get('pdf_id', ''));
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
