# Gerado pelo Kasy CLI
# Copie este arquivo para .env no desenvolvimento local
# O .env é a fonte local. --dart-define segue suportado para CI/release.

ENV=dev   # ou prod

# Supabase
BACKEND_URL=https://ocrpybzdjrcldvlpgccw.supabase.co
SUPABASE_TOKEN=https://ocrpybzdjrcldvlpgccw.supabase.co

# RevenueCat
# Chave Test Store (test_xxx) — usada automaticamente em simulador/emulador
RC_TEST_KEY=
# Chaves de produção — usadas automaticamente em dispositivo físico
RC_IOS_PROD_KEY=
RC_ANDROID_PROD_KEY=

# Sentry (apenas prod)
SENTRY_DSN=YOUR_SENTRY_DSN

# Mixpanel
MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN

# AI Chat — endpoint da Cloud/Edge Function (a chave de API fica no servidor, não aqui)
AI_CHAT_ENDPOINT=YOUR_FUNCTION_URL

# Ads (AdMob) — real ad unit ids, per platform and format. Leave blank to
# show Google TEST ads in debug builds; set the real ids before shipping a
# release build. The AdMob *app id* is native config — set it with
# `kasy configure` (or `kasy add ads`), not here.
ADMOB_ANDROID_BANNER=
ADMOB_IOS_BANNER=
ADMOB_ANDROID_INTERSTITIAL=
ADMOB_IOS_INTERSTITIAL=
ADMOB_ANDROID_REWARDED=
ADMOB_IOS_REWARDED=
ADMOB_ANDROID_REWARDED_INTERSTITIAL=
ADMOB_IOS_REWARDED_INTERSTITIAL=
