rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Auxiliar para checar se o usuário logado possui perfil de admin no Firestore
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // PDFs
    match /pdfs/{allPaths=**} {
      allow read: if request.auth != null;
    }

    match /pdfs/{userId}/{filename} {
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Avatares
    match /avatars/{allPaths=**} {
      allow read: if request.auth != null;
    }

    match /avatars/{userId}/{filename} {
      allow create, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Thumbnails dos PDFs
    match /thumbnails/{filename} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isAdmin();
    }
  }
}